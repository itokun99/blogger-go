"      66 /Users/aleph/Projects/blogger-go/auth.go\n       7 /Users/aleph/Projects/blogger-go/internal/doc.go\n     100 /Users/aleph/Projects/blogger-go/client.go\n       4 /Users/aleph/Projects/blogger-go/gen/schemas/doc.go\n     121 /Users/aleph/Projects/blogger-go/gen/builder/options.go\n       4 /Users/aleph/Projects/blogger-go/gen/builder/doc.go\n     178 /Users/aleph/Projects/blogger-go/gen/builder/builder.go\n     173 /Users/aleph/Projects/blogger-go/gen/builder/pagination.go\n     145 /Users/aleph/Projects/blogger-go/gen/builder/errors.go\n       4 /Users/aleph/Projects/blogger-go/gen/services/doc.go\n     110 /Users/aleph/Projects/blogger-go/client_test.go\n     912 total\n=== GOMOD ===\nmodule github.com/itokun99/blogger-go\n\ngo 1.26.0\n\nrequire (\n\tgolang.org/x/oauth2 v0.37.0\n\tgoogle.golang.org/api v0.299.0\n)\n\nrequire (\n\tcloud.google.com/go/auth v0.23.3 // indirect\n\tcloud.google.com/go/auth/oauth2adapt v0.2.8 // indirect\n\tcloud.google.com/go/compute/metadata v0.9.1 // indirect\n\tgithub.com/cespare/xxhash/v2 v2.3.0 // indirect\n\tgithub.com/felixge/httpsnoop v1.1.0 // indirect\n\tgithub.com/go-logr/logr v1.4.3 // indirect\n\tgithub.com/go-logr/stdr v1.2.2 // indirect\n\tgithub.com/google/s2a-go v0.1.10 // indirect\n\tgithub.com/google/uuid v1.6.0 // indirect\n\tgithub.com/googleapis/enterprise-certificate-proxy v0.3.22 // indirect\n\tgithub.com/googleapis/gax-go/v2 v2.24.1 // indirect\n\tgo.opentelemetry.io/auto/sdk v1.2.1 // indirect\n\tgo.opentelemetry.io/contrib/instrumentation/net/http/otelhttp v0.69.0 // indirect\n\tgo.opentelemetry.io/otel v1.44.0 // indirect\n\tgo.opentelemetry.io/otel/metric v1.44.0 // indirect\n\tgo.opentelemetry.io/otel/trace v1.44.0 // indirect\n\tgolang.org/x/crypto v0.57.0 // indirect\n\tgolang.org/x/net v0.59.0 // indirect\n\tgolang.org/x/sys v0.48.0 // indirect\n\tgolang.org/x/text v0.42.0 // indirect\n\tgoogle.golang.org/genproto/googleapis/rpc v0.0.0-20260921155816-b14227669459 // indirect\n\tgoogle.golang.org/grpc v1.84.0 // indirect\n\tgoogle.golang.org/protobuf v1.36.12 // indirect\n)\n=== README ===\n# blogger-go\n\nA Go SDK for the [Blogger API v3](https://developers.google.com/blogger/docs/3.0/getting_started),\ngenerated from Google's discovery document and layered over the official\n[`google.golang.org/api/blogger/v3`](https://pkg.go.dev/google.golang.org/api/blogger/v3) client.\n\nThe module provides:\n\n- `Client` - the entry point for talking to Blogger, wrapping OAuth2 credentials\n  and the upstream generated service.\n- `gen/schemas` - model structs derived from the discovery document.\n- `gen/services` - one implementation file per API resource (posts, blogs, comments, ...).\n- `gen/builder` - request builder types used by the generated service files.\n- `internal` - shared helpers that are not part of the public API.\n\n> Status: skeleton. Service methods and model structs land in later iterations;\n> the layout and public entry points are stable.\n\n## Install\n\n```sh\ngo get github.com/itokun99/blogger-go\n```\n\n## Minimal example\n\n```go\npackage main\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log\"\n\n\tblogger \"github.com/itokun99/blogger-go\"\n)\n\nfunc main() {\n\tctx := context.Background()\n\n\t// auth.TokenSourceFromJSON builds an OAuth2 token source from a\n\t// downloaded \"credentials.json\" and a cached token file.\n\tts, err := blogger.TokenSourceFromJSON(\"credentials.json\", \"token.json\")\n\tif err != nil {\n\t\tlog.Fatal(err)\n\t}\n\n\tclient, err := blogger.NewClient(ctx, ts)\n\tif err != nil {\n\t\tlog.Fatal(err)\n\t}\n\n\tblog, err := client.Blogger.Blogs.Get(\"1234567890\").Do()\n\tif err != nil {\n\t\tlog.Fatal(err)\n\t}\n\tfmt.Println(blog.Name)\n}\n```"
