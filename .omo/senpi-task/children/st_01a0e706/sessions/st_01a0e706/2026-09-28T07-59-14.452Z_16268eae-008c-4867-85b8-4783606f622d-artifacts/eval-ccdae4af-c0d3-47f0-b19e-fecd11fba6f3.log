{"text":"   240\t// list sends a listing request and decodes the returned page of posts.\n   241\tfunc (s *PostsService) list(ctx context.Context, path string, opts []PostOption, required ...PostOption) (*schemas.PostList, error) {\n   242\t\trequest := builder.New(http.MethodGet, path).Context(ctx)\n   243\t\tapplyOptions(request, append(required, opts...))\n   244\t\n   245\t\tlist := &schemas.PostList{Items: []*schemas.Post{}}\n   246\t\tif err := s.do(request, list); err != nil {\n   247\t\t\treturn nil, err\n   248\t\t}\n   249\t\n   250\t\treturn list, nil\n   251\t}\n   252\t\n   253\t// mutate sends body to a post endpoint and decodes the stored post.\n   254\tfunc (s *PostsService) mutate(ctx context.Context, method, path string, body *schemas.Post) (*schemas.Post, error) {\n   255\t\tif body == nil {\n   256\t\t\treturn nil, fmt.Errorf(\"blogger: post body is required\")\n   257\t\t}\n   258\t\n   259\t\trequest := builder.New(method, path).Context(ctx).Body(body)\n   260\t\n   261\t\tpost := &schemas.Post{}\n   262\t\tif err := s.do(request, post); err != nil {\n   263\t\t\treturn nil, err\n   264\t\t}\n   265\t\n   266\t\treturn post, nil\n   267\t}\n   268\t\n   269\t// action calls a post transition endpoint such as publish or revert.\n   270\tfunc (s *PostsService) action(ctx context.Context, name, blogId, postId string) (*schemas.Post, error) {\n   271\t\tif err := requireValues(\"blogId\", blogId, \"postId\", postId); err != nil {\n   272\t\t\treturn nil, err\n   273\t\t}\n   274\t\n   275\t\trequest := builder.New(http.MethodPost, postPath(blogId, postId)+\"/\"+name).Context(ctx)\n   276\t\n   277\t\tpost := &schemas.Post{}\n   278\t\tif err := s.do(request, post); err != nil {\n   279\t\t\treturn nil, err\n   280\t\t}\n   281\t\n   282\t\treturn post, nil\n   283\t}\n   284\t\n   285\t// do executes a posts request, failing before touching the network when the\n   286\t// service has no usable client.\n   287\tfunc (s *PostsService) do(b *builder.Builder, responseModel interface{}) error {\n   288\t\tif s.client == nil {\n   289\t\t\treturn fmt.Errorf(\"blogger: posts service has no client\")\n   290\t\t}\n   291\t\n   292\t\t_, err := b.Do(s.transport(), responseModel)\n   293\t\treturn err\n   294\t}\n   295\t\n   296\t// transport is the HTTP client requests are sent through. It carries the\n   297\t// transport of the generated service so authenticated requests keep working;\n   298\t// the base path resolves against the Blogger API root.\n   299\tfunc (s *PostsService) transport() builder.HTTPClient {\n   300\t\treturn postsClient{}\n   301\t}\n   302\t\n   303\t// postsClient resolves relative builder paths against the Blogger API root.\n   304\ttype postsClient struct{}\n   305\t\n   306\t// Do sends req through the shared HTTP client used by every generated service.\n   307\tfunc (postsClient) Do(req *http.Request) (*http.Response, error) {\n   308\t\treturn http.DefaultClient.Do(req)\n   309\t}\n   310\t\n   311\t// BasePath returns the API root the request path is resolved against.\n   312\tfunc (postsClient) BasePath() string {\n   313\t\treturn postsBasePath\n   314\t}\n   315\t\n   316\t// applyOptions applies every non-nil option to the request.\n   317\tfunc applyOptions(b *builder.Builder, opts []PostOption) {\n   318\t\tfor _, opt := range opts {\n   319\t\t\tif opt != nil {\n   320\t\t\t\topt(b)\n   321\t\t\t}\n   322\t\t}\n   323\t}\n   324\t\n   325\t// postPath is the request path of a single post, or of one of its\n   326\t// sub-resources once a suffix is appended.\n   327\tfunc postPath(blogId, postId string) string {\n   328\t\treturn fmt.Sprintf(\n   329\t\t\t\"v3/blogs/%s/posts/%s\",\n   330\t\t\turl.PathEscape(blogId),\n   331\t\t\turl.PathEscape(postId),\n   332\t\t)\n   333\t}\n   334\t\n   335\t// requireValues reports the first name whose paired value is empty.\n   336\tfunc requireValues(pairs ...string) error {\n   337\t\tfor i := 0; i+1 < len(pairs); i += 2 {\n   338\t\t\tif pairs[i+1] == \"\" {\n   339\t\t\t\treturn fmt.Errorf(\"blogger: %s is required\", pairs[i])\n   340\t\t\t}\n   341\t\t}\n   342\t\treturn nil\n   343\t}\n   344\t\n   345\t// joinLabels renders the labels of a listing as the comma-separated wire form.\n   346\tfunc joinLabels(labels []string) string {\n   347\t\tb := &strings.Builder{}\n   348\t\n   349\t\tfor _, label := range labels {\n   350\t\t\tlabel = strings.TrimSpace(label)\n   351\t\t\tif label == \"\" {\n   352\t\t\t\tcontinue\n   353\t\t\t}\n   354\t\t\tif b.Len() > 0 {\n   355\t\t\t\tb.WriteByte(',')\n   356\t\t\t}\n   357\t\t\tb.WriteString(label)\n   358\t\t}\n   359\t\n   360\t\treturn b.String()\n   361\t}","details":{"status":"completed"},"images":[],"hasError":false}
