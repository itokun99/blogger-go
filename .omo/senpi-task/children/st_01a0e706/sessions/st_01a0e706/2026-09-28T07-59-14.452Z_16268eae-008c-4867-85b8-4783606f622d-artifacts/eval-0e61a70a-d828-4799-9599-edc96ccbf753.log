{"text":"    90\t\treturn s.list(ctx, commentListPath(blogId, postId), opts)\n    91\t}\n    92\t\n    93\t// ListByBlog returns the comments of every post in the blog, narrowed by opts.\n    94\t// Use WithCommentPost to restrict the result to a single post.\n    95\t//\n    96\t// GET /v3/blogs/{blogId}/comments\n    97\tfunc (s *CommentsService) ListByBlog(ctx context.Context, blogId string, opts ...CommentListOption) (*schemas.CommentList, error) {\n    98\t\treturn s.list(ctx, blogCommentListPath(blogId), opts)\n    99\t}\n   100\t\n   101\t// Approve marks the comment as visible and returns it.\n   102\t//\n   103\t// POST /v3/blogs/{blogId}/posts/{postId}/comments/{commentId}/approve\n   104\tfunc (s *CommentsService) Approve(ctx context.Context, blogId, postId, commentId string) (*schemas.Comment, error) {\n   105\t\treturn s.action(ctx, \"approve\", blogId, postId, commentId)\n   106\t}\n   107\t\n   108\t// Delete removes the comment.\n   109\t//\n   110\t// DELETE /v3/blogs/{blogId}/posts/{postId}/comments/{commentId}\n   111\tfunc (s *CommentsService) Delete(ctx context.Context, blogId, postId, commentId string) error {\n   112\t\t_, err := s.do(\n   113\t\t\tbuilder.New(http.MethodDelete, commentPath(blogId, postId, commentId)).\n   114\t\t\t\tContext(ctx),\n   115\t\t\tnil,\n   116\t\t)\n   117\t\treturn err\n   118\t}\n   119\t\n   120\t// MarkAsSpam marks the comment as spam and returns it.\n   121\t//\n   122\t// POST /v3/blogs/{blogId}/posts/{postId}/comments/{commentId}/spam\n   123\tfunc (s *CommentsService) MarkAsSpam(ctx context.Context, blogId, postId, commentId string) (*schemas.Comment, error) {\n   124\t\treturn s.action(ctx, \"spam\", blogId, postId, commentId)\n   125\t}\n   126\t\n   127\t// RemoveContent removes the comment content while keeping the comment itself\n   128\t// in place, and returns the updated comment.\n   129\t//\n   130\t// POST /v3/blogs/{blogId}/posts/{postId}/comments/{commentId}/removecontent\n   131\tfunc (s *CommentsService) RemoveContent(ctx context.Context, blogId, postId, commentId string) (*schemas.Comment, error) {\n   132\t\treturn s.action(ctx, \"removecontent\", blogId, postId, commentId)\n   133\t}\n   134\t\n   135\t// list runs a comments listing against path, applying opts on top of the\n   136\t// pagination defaults.\n   137\tfunc (s *CommentsService) list(ctx context.Context, path string, opts []CommentListOption) (*schemas.CommentList, error) {\n   138\t\trequest := builder.New(http.MethodGet, path).Context(ctx)\n   139\t\n   140\t\tfor _, opt := range opts {\n   141\t\t\tif opt != nil {\n   142\t\t\t\topt(request)\n   143\t\t\t}\n   144\t\t}\n   145\t\n   146\t\t// Items is initialized explicitly so an empty page serializes as [] rather\n   147\t\t// than null.\n   148\t\tlist := &schemas.CommentList{Items: []*schemas.Comment{}}\n   149\t\tif _, err := s.do(request, list); err != nil {\n   150\t\t\treturn nil, err\n   151\t\t}\n   152\t\n   153\t\treturn list, nil\n   154\t}\n   155\t\n   156\t// action sends a POST to a comment sub-resource such as approve or spam.\n   157\tfunc (s *CommentsService) action(ctx context.Context, name, blogId, postId, commentId string) (*schemas.Comment, error) {\n   158\t\tcomment := &schemas.Comment{}\n   159\t\n   160\t\t_, err := s.do(\n   161\t\t\tbuilder.New(http.MethodPost, commentPath(blogId, postId, commentId)+\"/\"+name).\n   162\t\t\t\tContext(ctx),\n   163\t\t\tcomment,\n   164\t\t)\n   165\t\tif err != nil {\n   166\t\t\treturn nil, err\n   167\t\t}\n   168\t\n   169\t\treturn comment, nil\n   170\t}\n   171\t\n   172\t// do executes a comments request, failing before touching the network when the\n   173\t// service has no usable client.\n   174\tfunc (s *CommentsService) do(b *builder.Builder, responseModel interface{}) (interface{}, error) {\n   175\t\tif s.client == nil {\n   176\t\t\treturn nil, fmt.Errorf(\"blogger: comments service has no client\")\n   177\t\t}\n   178\t\treturn b.Do(s.transport(), responseModel)\n   179\t}\n   180\t\n   181\t// transport is the HTTP client requests are sent through. It prefers the\n   182\t// caller-supplied HTTP client so its transport is reused, falling back to the\n   183\t// default client so a service built without credentials still resolves paths\n   184\t// against the API root.\n   185\tfunc (s *CommentsService) transport() builder.HTTPClient {\n   186\t\tif s.client == nil {\n   187\t\t\treturn commentsClient{}\n   188\t\t}\n   189\t\treturn commentsClient{service: s.client.Service, client: s.httpClient()}\n   190\t}\n   191\t\n   192\t// httpClient returns the caller-supplied transport as a request sender, or nil\n   193\t// when the client relies on the default credentials.\n   194\tfunc (s *CommentsService) httpClient() func(*http.Request) (*http.Response, error) {\n   195\t\thttpClient := s.client.HTTPClient()\n   196\t\tif httpClient == nil {\n   197\t\t\treturn nil\n   198\t\t}\n   199\t\treturn httpClient.Do\n   200\t}\n   201\t\n   202\t// commentsClient adapts the generated Blogger service to builder.HTTPClient,\n   203\t// resolving relative builder paths against the service's own base path.\n   204\ttype commentsClient struct {\n   205\t\tservice *bloggerv3.Service\n   206\t\n   207\t\tclient func(*http.Request) (*http.Response, error)\n   208\t}\n   209\t\n   210\t// Do sends req through the client the generated service was built with, or the\n   211\t// default client when the service carries no separate transport.\n   212\tfunc (c commentsClient) Do(req *http.Request) (*http.Response, error) {\n   213\t\tif c.service == nil {\n   214\t\t\treturn http.DefaultClient.Do(req)\n   215\t\t}\n   216\t\tif c.client != nil {\n   217\t\t\treturn c.client(req)\n   218\t\t}\n   219\t\treturn http.DefaultClient.Do(req)\n   220\t}\n   221\t\n   222\t// BasePath returns the API root the request path is resolved against.\n   223\tfunc (c commentsClient) BasePath() string {\n   224\t\tif c.service == nil || c.service.BasePath == \"\" {\n   225\t\t\treturn commentsBasePath\n   226\t\t}\n   227\t\treturn c.service.BasePath\n   228\t}\n   229\t\n   230\t// commentPath is the request path of a single comment, or of one of its\n   231\t// sub-resources once a suffix is appended.\n   232\tfunc commentPath(blogId, postId, commentId string) string {\n   233\t\treturn commentListPath(blogId, postId) + \"/\" + url.PathEscape(commentId)\n   234\t}\n   235\t\n   236\t// commentListPath is the request path of the comments of a single post.\n   237\tfunc commentListPath(blogId, postId string) string {\n   238\t\treturn blogCommentListPath(blogId) + \"/posts/\" + url.PathEscape(postId) + \"/comments\"\n   239\t}\n   240\t\n   241\t// blogCommentListPath is the request path of every comment in a blog.\n   242\tfunc blogCommentListPath(blogId string) string {\n   243\t\treturn \"v3/blogs/\" + url.PathEscape(blogId) + \"/comments\"\n   244\t}","details":{"status":"completed"},"images":[],"hasError":false}
