{"text":"./gen/services/users.go:54:\tif err := requireValues(\"userId\", userId); err != nil {\n./gen/services/posts.go:113:\tif err := requireValues(\"blogId\", blogId, \"postId\", postId); err != nil {\n./gen/services/posts.go:131:\tif err := requireValues(\"blogId\", blogId); err != nil {\n./gen/services/posts.go:144:\tif err := requireValues(\"blogId\", blogId, \"q\", q); err != nil {\n./gen/services/posts.go:157:\tif err := requireValues(\"blogId\", blogId, \"path\", path); err != nil {\n./gen/services/posts.go:178:\tif err := requireValues(\"blogId\", blogId); err != nil {\n./gen/services/posts.go:191:\tif err := requireValues(\"blogId\", blogId, \"postId\", postId); err != nil {\n./gen/services/posts.go:202:\tif err := requireValues(\"blogId\", blogId, \"postId\", postId); err != nil {\n./gen/services/posts.go:213:\tif err := requireValues(\"blogId\", blogId, \"postId\", postId); err != nil {\n./gen/services/posts.go:271:\tif err := requireValues(\"blogId\", blogId, \"postId\", postId); err != nil {\n=== pages.go\n     1\t// Code generated for github.com/itokun99/blogger-go. DO NOT EDIT.\n     2\t\n     3\tpackage services\n     4\t\n     5\timport (\n     6\t\t\"context\"\n     7\t\t\"fmt\"\n     8\t\t\"net/http\"\n     9\t\t\"net/url\"\n    10\t\t\"strconv\"\n    11\t\n    12\t\tblogger \"github.com/itokun99/blogger-go\"\n    13\t\t\"github.com/itokun99/blogger-go/gen/builder\"\n    14\t\t\"github.com/itokun99/blogger-go/gen/schemas\"\n    15\t\tbloggerv3 \"google.golang.org/api/blogger/v3\"\n    16\t)\n    17\t\n    18\t// pagesBasePath is the Blogger v3 API root the pages paths resolve against:\n    19\t// GET /v3/blogs/{blogId}/pages.\n    20\tconst pagesBasePath = \"https://blogger.googleapis.com/\"\n    21\t\n    22\t// PagesService implements the Blogger v3 pages resource.\n    23\ttype PagesService struct {\n    24\t\tclient *blogger.Client\n    25\t}\n    26\t\n    27\t// NewPagesService returns a PagesService bound to client, which supplies the\n    28\t// transport and API base path for every request.\n    29\tfunc NewPagesService(client *blogger.Client) *PagesService {\n    30\t\treturn &PagesService{client: client}\n    31\t}\n    32\t\n    33\t// PageListOption customises a pages list request. Options are applied in order\n    34\t// after the required path parameters.\n    35\ttype PageListOption func(*builder.Builder)\n    36\t\n    37\t// WithPageListToken continues a listing from the cursor returned as\n    38\t// nextPageToken.\n    39\tfunc WithPageListToken(token string) PageListOption {\n    40\t\treturn func(b *builder.Builder) {\n    41\t\t\tb.Param(builder.PageToken, token)\n    42\t\t}\n    43\t}\n    44\t\n    45\t// WithPageListMaxResults caps the number of pages returned in a single request.\n    46\tfunc WithPageListMaxResults(maxResults int64) PageListOption {\n    47\t\treturn func(b *builder.Builder) {\n    48\t\t\tb.Param(builder.MaxResults, strconv.FormatInt(maxResults, 10))\n    49\t\t}\n    50\t}\n    51\t\n    52\t// PageStatus values accepted by pages.list.\n    53\tconst (\n    54\t\tPageStatusLive        = \"LIVE\"\n    55\t\tPageStatusDraft       = \"DRAFT\"\n    56\t\tPageStatusSoftTrashed = \"SOFT_TRASHED\"\n    57\t)\n    58\t\n    59\t// WithPageListStatus restricts the listing to pages in the given status.\n    60\tfunc WithPageListStatus(status string) PageListOption {\n    61\t\treturn func(b *builder.Builder) {\n    62\t\t\tb.Param(builder.Status, status)\n    63\t\t}\n    64\t}\n    65\t\n    66\t// Get returns the page with the given id.\n    67\t//\n    68\t// GET /v3/blogs/{blogId}/pages/{pageId}\n    69\tfunc (s *PagesService) Get(ctx context.Context, blogId, pageId string) (*schemas.Page, error) {\n    70\t\tif err := requireValues(\"blogId\", blogId, \"pageId\", pageId); err != nil {\n    71\t\t\treturn nil, err\n    72\t\t}\n    73\t\n    74\t\tpage := &schemas.Page{}\n    75\t\trequest := builder.New(http.MethodGet, pagePath(blogId, pageId)).Context(ctx)\n    76\t\n    77\t\tif err := s.do(request, page); err != nil {\n    78\t\t\treturn nil, err\n    79\t\t}\n    80\t\n    81\t\treturn page, nil\n    82\t}\n    83\t\n    84\t// List returns the pages of a blog, narrowed by opts.\n    85\t//\n    86\t// GET /v3/blogs/{blogId}/pages\n    87\tfunc (s *PagesService) List(ctx context.Context, blogId string, opts ...PageListOption) (*schemas.PageList, error) {\n    88\t\tif err := requireValues(\"blogId\", blogId); err != nil {\n    89\t\t\treturn nil, err\n    90\t\t}\n    91\t\n    92\t\tpath := fmt.Sprintf(\"v3/blogs/%s/pages\", url.PathEscape(blogId))\n    93\t\trequest := builder.New(http.MethodGet, path).Context(ctx)\n    94\t\tapplyPageOptions(request, opts)\n    95\t\n    96\t\tlist := &schemas.PageList{Items: []*schemas.Page{}}\n    97\t\tif err := s.do(request, list); err != nil {\n    98\t\t\treturn nil, err\n    99\t\t}\n   100\t\n   101\t\treturn list, nil\n   102\t}\n   103\t\n   104\t// Insert creates a page on the blog and returns the stored page.\n   105\t//\n   106\t// POST /v3/blogs/{blogId}/pages\n   107\tfunc (s *PagesService) Insert(ctx context.Context, blogId string, body *schemas.Page) (*schemas.Page, error) {\n   108\t\tif err := requireValues(\"blogId\", blogId); err != nil {\n   109\t\t\treturn nil, err\n   110\t\t}\n   111\t\n   112\t\tpath := fmt.Sprintf(\"v3/blogs/%s/pages\", url.PathEscape(blogId))\n   113\t\treturn s.mutate(ctx, http.MethodPost, path, body)\n   114\t}\n   115\t\n   116\t// Update replaces the page and returns the stored page.\n   117\t//\n   118\t// PUT /v3/blogs/{blogId}/pages/{pageId}\n   119\tfunc (s *PagesService) Update(ctx context.Context, blogId, pageId string, body *schemas.Page) (*schemas.Page, error) {\n   120\t\tif err := requireValues(\"blogId\", blogId, \"pageId\", pageId); err != nil {\n   121\t\t\treturn nil, err\n   122\t\t}\n   123\t\n   124\t\treturn s.mutate(ctx, http.MethodPut, pagePath(blogId, pageId), body)\n   125\t}\n   126\t\n   127\t// Patch updates the provided fields of the page and returns the stored page.\n   128\t//\n   129\t// PATCH /v3/blogs/{blogId}/pages/{pageId}\n   130\tfunc (s *PagesService) Patch(ctx context.Context, blogId, pageId string, body *schemas.Page) (*schemas.Page, error) {\n   131\t\tif err := requireValues(\"blogId\", blogId, \"pageId\", pageId); err != nil {\n   132\t\t\treturn nil, err\n   133\t\t}\n   134\t\n   135\t\treturn s.mutate(ctx, http.MethodPatch, pagePath(blogId, pageId), body)\n   136\t}\n   137\t\n   138\t// Delete removes the page.\n   139\t//\n   140\t// DELETE /v3/blogs/{blogId}/pages/{pageId}\n   141\tfunc (s *PagesService) Delete(ctx context.Context, blogId, pageId string) error {\n   142\t\tif err := requireValues(\"blogId\", blogId, \"pageId\", pageId); err != nil {\n   143\t\t\treturn err\n   144\t\t}\n   145\t\n   146\t\trequest := builder.New(http.MethodDelete, pagePath(blogId, pageId)).Context(ctx)\n   147\t\n   148\t\treturn s.do(request, nil)\n   149\t}\n   150\t\n   151\t// Publish makes the page publicly visible and returns it.\n   152\t//\n   153\t// POST /v3/blogs/{blogId}/pages/{pageId}/publish\n   154\tfunc (s *PagesService) Publish(ctx context.Context, blogId, pageId string) (*schemas.Page, error) {\n   155\t\treturn s.action(ctx, \"publish\", blogId, pageId)\n   156\t}\n   157\t\n   158\t// Revert discards the unpublished changes of the page and returns the stored\n   159\t// page.\n   160\t//\n   161\t// POST /v3/blogs/{blogId}/pages/{pageId}/revert\n   162\tfunc (s *PagesService) Revert(ctx context.Context, blogId, pageId string) (*schemas.Page, error) {\n   163\t\treturn s.action(ctx, \"revert\", blogId, pageId)\n   164\t}\n   165\t\n   166\t// mutate sends body to a page endpoint and decodes the stored page.\n   167\tfunc (s *PagesService) mutate(ctx context.Context, method, path string, body *schemas.Page) (*schemas.Page, error) {\n   168\t\tif body == nil {\n   169\t\t\treturn nil, fmt.Errorf(\"blogger: page body is required\")\n   170\t\t}\n   171\t\n   172\t\trequest := builder.New(method, path).Context(ctx).Body(body)\n   173\t\n   174\t\tpage := &schemas.Page{}\n   175\t\tif err := s.do(request, page); err != nil {\n   176\t\t\treturn nil, err\n   177\t\t}\n   178\t\n   179\t\treturn page, nil\n   180\t}\n   181\t\n   182\t// action calls a page transition endpoint such as publish or revert.\n   183\tfunc (s *PagesService) action(ctx context.Context, name, blogId, pageId string) (*schemas.Page, error) {\n   184\t\tif err := requireValues(\"blogId\", blogId, \"pageId\", pageId); err != nil {\n   185\t\t\treturn nil, err\n   186\t\t}\n   187\t\n   188\t\trequest := builder.New(http.MethodPost, pagePath(blogId, pageId)+\"/\"+name).Context(ctx)\n   189\t\n   190\t\tpage := &schemas.Page{}\n   191\t\tif err := s.do(request, page); err != nil {\n   192\t\t\treturn nil, err\n   193\t\t}\n   194\t\n   195\t\treturn page, nil\n   196\t}\n   197\t\n   198\t// do executes a pages request, failing before touching the network when the\n   199\t// service has no usable client.\n   200\tfunc (s *PagesService) do(b *builder.Builder, responseModel interface{}) error {\n   201\t\tif s.client == nil {\n   202\t\t\treturn fmt.Errorf(\"blogger: pages service has no client\")\n   203\t\t}\n   204\t\n   205\t\t_, err := b.Do(s.transport(), responseModel)\n   206\t\treturn err\n   207\t}\n   208\t\n   209\t// transport is the HTTP client requests are sent through. It prefers the\n   210\t// authenticated transport the generated service was built with, falling back\n   211\t// to the default client so a service without credentials still resolves paths\n   212\t// against the API root.\n   213\tfunc (s *PagesService) transport() builder.HTTPClient {\n   214\t\tclient := pagesClient{}\n   215\t\tif s.client != nil {\n   216\t\t\tclient.service = s.client.Service\n   217\t\t\tclient.httpClient = s.client.HTTPClient()\n   218\t\t}\n   219\t\n   220\t\treturn client\n   221\t}\n   222\t\n   223\t// pagesClient adapts the generated Blogger service to builder.HTTPClient,\n   224\t// resolving relative builder paths against the service's own base path.\n   225\ttype pagesClient struct {\n   226\t\tservice *bloggerv3.Service\n   227\t\n   228\t\thttpClient *http.Client\n   229\t}\n   230\t\n   231\t// Do sends req through the generated service's authenticated transport, or the\n   232\t// default client when the service carries none.\n   233\tfunc (c pagesClient) Do(req *http.Request) (*http.Response, error) {\n   234\t\tif c.httpClient == nil {\n   235\t\t\treturn http.DefaultClient.Do(req)\n   236\t\t}\n   237\t\treturn c.httpClient.Do(req)\n   238\t}\n   239\t\n   240\t// BasePath returns the API root the request path is resolved against.\n   241\tfunc (c pagesClient) BasePath() string {\n   242\t\tif c.service == nil || c.service.BasePath == \"\" {\n   243\t\t\treturn pagesBasePath\n   244\t\t}\n   245\t\treturn c.service.BasePath\n   246\t}\n   247\t\n   248\t// applyPageOptions applies every non-nil option to the request.\n   249\tfunc applyPageOptions(b *builder.Builder, opts []PageListOption) {\n   250\t\tfor _, opt := range opts {\n   251\t\t\tif opt != nil {\n   252\t\t\t\topt(b)\n   253\t\t\t}\n   254\t\t}\n   255\t}\n   256\t\n   257\t// pagePath is the request path of a single page, or of one of its\n   258\t// sub-resources once a suffix is appended.\n   259\tfunc pagePath(blogId, pageId string) string {\n   260\t\treturn fmt.Sprintf(\n   261\t\t\t\"v3/blogs/%s/pages/%s\",\n   262\t\t\turl.PathEscape(blogId),\n   263\t\t\turl.PathEscape(pageId),\n   264\t\t)\n   265\t}","details":{"status":"completed"},"images":[],"hasError":false}
