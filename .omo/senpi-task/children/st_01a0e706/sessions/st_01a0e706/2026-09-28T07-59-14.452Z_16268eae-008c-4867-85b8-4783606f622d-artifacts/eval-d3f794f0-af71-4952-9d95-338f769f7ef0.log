ed fields of the post and returns the stored post.\n   199\t//\n   200\t// PATCH /v3/blogs/{blogId}/posts/{postId}\n   201\tfunc (s *PostsService) Patch(ctx context.Context, blogId, postId string, body *schemas.Post) (*schemas.Post, error) {\n   202\t\tif err := requireValues(\"blogId\", blogId, \"postId\", postId); err != nil {\n   203\t\t\treturn nil, err\n   204\t\t}\n   205\t\n   206\t\treturn s.mutate(ctx, http.MethodPatch, postPath(blogId, postId), body)\n   207\t}\n   208\t\n   209\t// Delete removes the post.\n   210\t//\n   211\t// DELETE /v3/blogs/{blogId}/posts/{postId}\n   212\tfunc (s *PostsService) Delete(ctx context.Context, blogId, postId string) error {\n   213\t\tif err := requireValues(\"blogId\", blogId, \"postId\", postId); err != nil {\n   214\t\t\treturn err\n   215\t\t}\n   216\t\n   217\t\trequest := builder.New(http.MethodDelete, postPath(blogId, postId)).Context(ctx)\n   218\t\tif err := s.do(request, nil); err != nil {\n   219\t\t\treturn err\n   220\t\t}\n   221\t\n   222\t\treturn nil\n   223\t}\n   224\t\n   225\t// Publish makes the post publicly visible and returns it.\n   226\t//\n   227\t// POST /v3/blogs/{blogId}/posts/{postId}/publish\n   228\tfunc (s *PostsService) Publish(ctx context.Context, blogId, postId string) (*schemas.Post, error) {\n   229\t\treturn s.action(ctx, \"publish\", blogId, postId)\n   230\t}\n   231\t\n   232\t// Revert discards the unpublished changes of the post and returns the stored\n   233\t// post.\n   234\t//\n   235\t// POST /v3/blogs/{blogId}/posts/{postId}/revert\n   236\tfunc (s *PostsService) Revert(ctx context.Context, blogId, postId string) (*schemas.Post, error) {\n   237\t\treturn s.action(ctx, \"revert\", blogId, postId)\n   238\t}\n   239\t\n   240\t// list sends a listing request and decodes the returned page of posts.","details":{"status":"completed"},"images":[],"hasError":false}
